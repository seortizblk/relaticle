# Configuration for the production stack. Copy it and fill it in — every empty
# value below is something the application needs:
#
#   cp docker/.env.prod.example docker/.env.prod
#   php -r 'echo "APP_KEY=base64:", base64_encode(random_bytes(32)), PHP_EOL;'
#   openssl rand -hex 32     # DB_PASSWORD, REDIS_PASSWORD, REVERB_APP_SECRET, REVERB_APP_KEY
#
# docker/.env.prod is git-ignored. It is both:
#   - the file compose interpolates (ports, build args), and
#   - the env_file of every application container,
# so a value written here reaches php-fpm, Horizon, the scheduler and Reverb.
#
# Infrastructure wiring (DB_HOST, REDIS_HOST, BROADCAST_REVERB_HOST …) is set by
# docker/compose.prod.yml and must NOT be repeated here.

# ─── Application ────────────────────────────────────────────────────────────
APP_NAME=Relaticle
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# The public URL. Behind a proxy this is the https:// address users type.
APP_URL=https://crm.example.com
# Port on the host that maps to the container's 8080. 80 is fine when a proxy
# terminates TLS in front of the stack; set 127.0.0.1:8080 to keep it private.
APP_PORT=80
TRUSTED_HOSTS=crm.example.com
TRUSTED_PROXIES=
LOG_LEVEL=warning

# ─── Database (postgres service) ────────────────────────────────────────────
DB_DATABASE=relaticle
DB_USERNAME=relaticle
DB_PASSWORD=

# ─── Redis (cache, session, queue, Horizon) ─────────────────────────────────
# Required: the redis service refuses to start without it. Never 'null'.
REDIS_PASSWORD=

# ─── Session and cookies ────────────────────────────────────────────────────
# Set to true when APP_URL is https, so the session cookie is only sent over TLS.
SESSION_SECURE_COOKIE=true

# ─── Mail ───────────────────────────────────────────────────────────────────
# 'log' writes the messages to the container log and sends nothing.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Horizon ────────────────────────────────────────────────────────────────
# Comma-separated emails allowed to open /horizon. Empty denies everyone.
HORIZON_ADMIN_EMAILS=

# ─── Reverb (realtime chat streaming) ───────────────────────────────────────
# REVERB_HOST/PORT/SCHEME are what a browser opens the WebSocket against, and
# what the Content-Security-Policy allows: they must be reachable from outside.
# VITE_REVERB_* does not belong here — compose builds it from these values.
#
# Reverb does not terminate TLS. For wss:// put a reverse proxy in front,
# set REVERB_SCHEME=https and REVERB_PORT=443, and REVERB_PUBLISH_PORT=8080
# (the proxy forwards to it after terminating TLS).
REVERB_APP_ID=relaticle
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=crm.example.com
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLISH_PORT=8080

# ─── Storage ────────────────────────────────────────────────────────────────
# 'local' keeps uploads in the storage volume. For S3-style storage see the
# .env.example in the repository root (AWS_* keys).
FILESYSTEM_DISK=local
MEDIA_DISK=local

# ─── Image ──────────────────────────────────────────────────────────────────
# Built from the repository's Dockerfile by default. Uncomment to run the image
# published by the project instead (docker compose pull) — remember that the
# JavaScript bundle of that image was built with the project's own Reverb
# settings, not yours.
#IMAGE=ghcr.io/relaticle/relaticle:latest

# ─── Optional integrations ──────────────────────────────────────────────────
# Sentry, Stripe/Cashier, Google and Microsoft OAuth, OpenAI/Anthropic for the
# assistant, Gmail/Microsoft Graph for the email integration: see the repository
# root .env.example, which documents every key the application reads.
#SENTRY_LARAVEL_DSN=
#STRIPE_KEY=
#STRIPE_SECRET=
