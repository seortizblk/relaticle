# Values docker/compose.dev.yml interpolates (${…}).
#
#   cp docker/.env.dev.example docker/.env.dev
#   docker compose -f docker/compose.dev.yml --env-file docker/.env.dev up -d --build
#
# docker/.env.dev is NOT the application's .env: that one is created from
# .env.example by docker/dev/entrypoint.d/40-relaticle-dev-bootstrap.sh, lives
# on the bind-mounted repository and holds the generated APP_KEY.
#
# Every value below already has a default in the compose file, so this file only
# exists to make the knobs visible. Only edit it to change ports or credentials.
# docker/.env.dev is git-ignored.

APP_NAME=Relaticle

# Published ports on the host.
APP_PORT=8000
VITE_PORT=5173
REVERB_PORT=8080
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Host name the browser uses. Keep it in sync with APP_URL; change it when the
# dev stack is reached from another machine.
VITE_HOST=localhost
APP_URL=http://localhost:8000
# The browser opens the WebSocket here, and the Content-Security-Policy allows
# this origin. VITE_REVERB_HOST follows it.
REVERB_HOST=localhost

# Host user that owns the files the containers create on the bind mount (.env,
# storage/logs, …). On Linux set these to `id -u` and `id -g`, then rebuild:
# `make -f docker/Makefile dev-build`. Docker Desktop on macOS ignores them.
WWWUSER=1000
WWWGROUP=1000

# Development database and cache. Throwaway values: nothing here listens on a
# public interface.
DB_DATABASE=relaticle
DB_USERNAME=relaticle
DB_PASSWORD=secret

# Reverb (the WebSocket server behind chat streaming). Local-only values; a
# deployment generates its own.
REVERB_APP_ID=relaticle
REVERB_APP_KEY=relaticle-local-key
REVERB_APP_SECRET=relaticle-local-secret

# xdebug. PHP_XDEBUG_MODE=off turns it off completely.
PHP_XDEBUG_MODE=develop,debug
PHP_XDEBUG_START_WITH_REQUEST=trigger
PHP_XDEBUG_CLIENT_HOST=host.docker.internal
PHP_XDEBUG_CLIENT_PORT=9003
PHP_XDEBUG_IDEKEY=VSCODE

LOG_LEVEL=debug
